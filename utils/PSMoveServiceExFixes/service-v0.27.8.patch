+// Runs on the service main thread after timestamp sorting, before pose fusion.
+void ServerControllerView::updateGyroAutoCalibration(PoseSensorPacket &packet)
+{
+    auto *controller=castChecked<PSDualShock4Controller>();
+    auto config=*controller->getConfig();
+    auto &learner=m_gyroAutoCalibration;
+    const double now=std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count();
+    const double t=std::chrono::duration<double>(packet.timestamp.time_since_epoch()).count();
+    const float toDegrees=180.f/3.14159265358979323846f;
+    const float gain=config.gyro_gain*toDegrees;
+    if (!std::isfinite(gain) || gain<=0.f) return;
+    Eigen::Vector3f bias(config.raw_gyro_bias.i,config.raw_gyro_bias.j,config.raw_gyro_bias.k);
+    if(m_gyroAutoHasExpected && ((bias-m_gyroAutoExpectedBias).norm()>.0001f || gain!=m_gyroAutoExpectedGain))
+        learner.resetSession(); // Manual calibration/gain changes take precedence.
+    m_gyroAutoExpectedBias=bias; m_gyroAutoExpectedGain=gain; m_gyroAutoHasExpected=true;
+    const bool ioDue=m_gyroAutoLastIO<0. || now-m_gyroAutoLastIO>=1.;
+    bool settingsError=false;
+    if(ioDue) {
+        m_gyroAutoLastIO=now;
+        GyroAutoCalibration::Settings s;
+        try {
+            std::ifstream input("gyro-autocalibration.json");
+            if(input.good()) {
+                boost::property_tree::ptree pt; boost::property_tree::read_json(input,pt);
+                s.enabled=pt.get<bool>("enabled",false);
+                s.requireOptical=pt.get<bool>("requireOptical",false);
+                auto number=[&](const char* name,double fallback,double lo,double hi) {
+                    double v=pt.get<double>(name,fallback);
+                    if(!std::isfinite(v) || v<lo || v>hi) throw std::runtime_error("Invalid gyro calibration setting");
+                    return v;
+                };
+                s.window=number("windowSeconds",5.,5.,30.);
+                s.gyroLimit=number("gyroLimitDps",.08,.02,1.);
+                s.gyroStd=number("gyroStdDps",.25,.01,.5);
+                s.accelStd=number("accelStdG",.015,.001,.05);
+                s.opticalAngle=number("opticalAngleDegrees",1.25,.1,2.);
+                s.opticalPosition=number("opticalPositionMeters",.01,.002,.03);
+                s.maxStep=number("maxStepDps",.01,.001,.02);
+                s.maxTotal=number("maxSessionCorrectionDps",.25,.02,.5);
+            }
+        } catch(...) { s.enabled=false;settingsError=true; }
+        const auto &old=learner.settings;
+        if(s.enabled!=old.enabled || s.requireOptical!=old.requireOptical || s.window!=old.window || s.gyroLimit!=old.gyroLimit || s.gyroStd!=old.gyroStd || s.accelStd!=old.accelStd || s.opticalAngle!=old.opticalAngle || s.opticalPosition!=old.opticalPosition || s.maxStep!=old.maxStep || s.maxTotal!=old.maxTotal)
+            learner.resetWindow("Settings changed");
+        learner.settings=s;
+    }
+    if(packet.has_optical_measurement())
+        learner.observeOptical(t,packet.has_valid_optical_orientation && getIsCurrentlyTracking() && DeviceManager::getInstance()->m_tracker_manager->trackersSynced(),packet.get_optical_position_in_meters(),packet.optical_orientation);
+    if(packet.has_gyroscope_measurement && packet.has_accelerometer_measurement) {
+        Eigen::Vector3f raw(float(packet.raw_imu_gyroscope.i),float(packet.raw_imu_gyroscope.j),float(packet.raw_imu_gyroscope.k));
+        Eigen::Vector3f next;
+        if(m_gyroAutoLastSave<0.) m_gyroAutoLastSave=now;
+        if(learner.observeImu(t,raw*gain,packet.imu_accelerometer_g_units,bias*gain,next)) {
+            bias=next/gain;
+            config.raw_gyro_bias.set(bias.x(),bias.y(),bias.z());
+            const bool persist=now-m_gyroAutoLastSave>=60.;
+            controller->setConfig(&config,persist);
+            if(persist) m_gyroAutoLastSave=now;
+            m_gyroAutoExpectedBias=bias;
+        }
+        // Recompute queued IMU samples against the latest bias before fusion.
+        packet.imu_gyroscope_rad_per_sec=(raw-bias)*config.gyro_gain;
+    }
+    if(ioDue) {
+        try {
+            boost::property_tree::ptree status;
+            status.put("controllerId",getDeviceID());
+            status.put("enabled",learner.settings.enabled);
+            status.put("stillnessSource",learner.settings.requireOptical?"IMU plus optical gate":"IMU only (gyro + accelerometer)");
+            status.put("reason",settingsError?"Invalid settings; learning disabled":learner.reason);
+            status.put("windowProgressSeconds",learner.progress);
+            status.put("lastResetReason",learner.lastResetReason);
+            status.put("longestWindowSeconds",learner.longestWindow);
+            status.put("windowSeconds",learner.settings.window);
+            status.put("acceptedWindows",learner.updates);
+            status.put("secondsSinceUpdate",learner.lastUpdate<0.?-1.:std::max(0.,t-learner.lastUpdate));
+            status.put("biasDps.x",bias.x()*gain); status.put("biasDps.y",bias.y()*gain); status.put("biasDps.z",bias.z()*gain);
+            status.put("savePolicy","Memory updates; persist on accepted window at most once per 60 seconds. Disabling keeps learned bias.");
+            const std::string name="gyro-autocalibration-status-"+std::to_string(getDeviceID())+".json";
+            const std::string temp=name+".tmp";
+            boost::property_tree::write_json(temp,status);
+            MoveFileExA(temp.c_str(),name.c_str(),MOVEFILE_REPLACE_EXISTING);
+        } catch(...) { /* Status IO must not stop tracking. */ }
+    }
+}
