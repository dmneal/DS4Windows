diff --git a/src/psmoveservice/Filter/GyroAutoCalibration.h b/src/psmoveservice/Filter/GyroAutoCalibration.h
new file mode 100644
index 0000000..e90938e
--- /dev/null
+++ b/src/psmoveservice/Filter/GyroAutoCalibration.h
@@ -0,0 +1,115 @@
+#pragma once
+#include <Eigen/Core>
+#include <Eigen/Geometry>
+#include <vector>
+#include <cmath>
+#include <algorithm>
+
+// Stationary bias learning only; does not change pose fusion or gyro gain.
+// Time-based windows inspired by Valve's public calibration notes. This is an
+// independent implementation, not Steam's unavailable internal estimator.
+class GyroAutoCalibration {
+public:
+    struct Settings {
+        bool enabled = false;
+        bool requireOptical = false;
+        double window = 5.;
+        double gyroLimit = .08;       // residual deg/s
+        double gyroStd = .25;         // per-axis deg/s
+        double accelStd = .015;       // g
+        double opticalAngle = 1.25;     // degrees between first/last quarter means
+        double opticalPosition = .01; // meters between first/last quarter means
+        double maxStep = .01;         // deg/s per accepted window, vector norm
+        double maxTotal = .25;        // deg/s from session starting bias
+    } settings;
+    const char* reason = "Disabled";
+    const char* lastResetReason = "None";
+    double longestWindow = 0.;
+    double progress = 0.;
+    unsigned updates = 0;
+    double lastUpdate = -1.;
+    Eigen::Vector3f sessionBias = Eigen::Vector3f::Zero();
+    bool sessionStarted = false;
+
+    void resetWindow(const char* why) { imu.clear(); optical.clear(); progress=0.; reason=why; lastResetReason=why; }
+    void resetSession() { resetWindow("Settings or manual calibration changed"); sessionStarted=false; }
+    void observeOptical(double t, bool valid, const Eigen::Vector3f& p, const Eigen::Quaternionf& q) {
+        if (!settings.enabled) { resetWindow("Disabled"); return; }
+        if (!settings.requireOptical) return;
+        if (!valid || !std::isfinite(t) || !p.allFinite() || !q.coeffs().allFinite() || q.norm()<.5f) {
+            lastOptical=-1.; resetWindow("Waiting for valid optical orientation"); return;
+        }
+        if (lastOptical>=0. && (t<=lastOptical || t-lastOptical>.2)) resetWindow("Camera gap");
+        lastOptical=t;
+        if (!imu.empty() && optical.size()<4096) optical.push_back({t,p,q.normalized()});
+    }
+    // Raw gyro is converted to deg/s before entry; output bias is also deg/s.
+    bool observeImu(double t, const Eigen::Vector3f& raw, const Eigen::Vector3f& accel,
+                    const Eigen::Vector3f& currentBias, Eigen::Vector3f& nextBias) {
+        if (!settings.enabled) { resetWindow("Disabled"); return false; }
+        if (!std::isfinite(t) || !raw.allFinite() || !accel.allFinite() || !currentBias.allFinite()) {
+            resetWindow("Invalid sensor values"); return false;
+        }
+        if (!sessionStarted) { sessionBias=currentBias; sessionStarted=true; }
+        // Camera packets may be consumed just before a slightly older queued
+        // IMU packet in the next main-thread batch. Allow that bounded skew.
+        if (settings.requireOptical && (lastOptical<0. || std::abs(t-lastOptical)>.2)) {
+            resetWindow("Waiting for fresh camera orientation"); return false;
+        }
+        // Individual noisy samples may exceed the mean-rate tolerance. Apply
+        // a noise allowance here and test the window mean separately below.
+        if ((raw-currentBias).norm()>settings.gyroLimit+4.*settings.gyroStd || std::abs(accel.norm()-1.f)>.08f) {
+            resetWindow("Movement / acceleration detected"); return false;
+        }
+        if (!imu.empty() && (t<=imu.back().t || t-imu.back().t>.1)) resetWindow("IMU gap");
+        if (imu.size()>=20000) { resetWindow("Sample limit exceeded"); return false; }
+        imu.push_back({t,raw,accel});
+        progress=t-imu.front().t; reason="Collecting stillness window";
+        longestWindow=std::max(longestWindow,progress);
+        if (progress<settings.window) return false;
+        if (imu.size()<100 || (settings.requireOptical && optical.size()<50)) { resetWindow("Insufficient fresh samples"); return false; }
+        Eigen::Vector3d mean=Eigen::Vector3d::Zero(), amean=mean, gvar=mean, avar=mean;
+        for (const auto& s:imu) { mean+=s.g.cast<double>(); amean+=s.a.cast<double>(); }
+        mean/=double(imu.size()); amean/=double(imu.size());
+        if((mean-currentBias.cast<double>()).norm()>settings.gyroLimit) {resetWindow("Mean gyro rate exceeds stillness tolerance");return false;}
+        for (const auto& s:imu) { gvar+=(s.g.cast<double>()-mean).array().square().matrix(); avar+=(s.a.cast<double>()-amean).array().square().matrix(); }
+        gvar/=double(imu.size()); avar/=double(imu.size());
+        if (gvar.maxCoeff()>settings.gyroStd*settings.gyroStd || avar.maxCoeff()>settings.accelStd*settings.accelStd) {
+            resetWindow("Sensor variation exceeds stillness tolerance"); return false;
+        }
+        // Camera means reduce optical jitter; no fused orientation is used as
+        // stillness evidence (that would circularly validate gyro integration).
+        if (settings.requireOptical) {
+        Eigen::Vector4d qa=Eigen::Vector4d::Zero(), qb=qa;
+        Eigen::Vector3d pa=Eigen::Vector3d::Zero(), pb=pa, aa=pa, ab=pa;
+        int na=0,nb=0,nia=0,nib=0;
+        const double start=imu.front().t, quarter=settings.window*.25;
+        for (const auto& s:optical) {
+            Eigen::Vector4d q=s.q.coeffs().cast<double>();
+            if (q.dot(optical.front().q.coeffs().cast<double>())<0) q=-q;
+            if (s.t<=start+quarter) {qa+=q;pa+=s.p.cast<double>();++na;}
+            if (s.t>=t-quarter) {qb+=q;pb+=s.p.cast<double>();++nb;}
+        }
+        for (const auto& s:imu) {
+            if(s.t<=start+quarter) {aa+=s.a.cast<double>();++nia;}
+            if(s.t>=t-quarter) {ab+=s.a.cast<double>();++nib;}
+        }
+        if(na<10 || nb<10 || qa.norm()<1e-6 || qb.norm()<1e-6) {resetWindow("Insufficient camera window coverage");return false;}
+        double angle=2.*std::acos(std::min(1.,std::abs(qa.normalized().dot(qb.normalized()))))*180./3.141592653589793;
+        if(angle>settings.opticalAngle || (pa/na-pb/nb).norm()>settings.opticalPosition || (aa/nia-ab/nib).norm()>.01) {
+            resetWindow("Camera / gravity indicates slow movement"); return false;
+        }
+        }
+        Eigen::Vector3f delta=(mean.cast<float>()-currentBias)*.25f;
+        if(delta.norm()>settings.maxStep) delta*=float(settings.maxStep/delta.norm());
+        nextBias=currentBias+delta;
+        if((nextBias-sessionBias).norm()>settings.maxTotal) {resetWindow("Session correction limit reached; manual calibration needed");return false;}
+        ++updates; lastUpdate=t; resetWindow("Bias updated; waiting for next stillness window"); return true;
+    }
+private:
+    struct Imu {double t;Eigen::Vector3f g,a;};
+    struct Optical {double t;Eigen::Vector3f p;Eigen::Quaternionf q;};
+    std::vector<Imu> imu;
+    std::vector<Optical> optical;
+    double lastOptical=-1.;
+};
