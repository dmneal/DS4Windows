diff --git a/src/psmovemath/OpticalCalibrationValidation.h b/src/psmovemath/OpticalCalibrationValidation.h
new file mode 100644
index 0000000..09c33a8
--- /dev/null
+++ b/src/psmovemath/OpticalCalibrationValidation.h
@@ -0,0 +1,17 @@
+#pragma once
+#include <cmath>
+
+namespace optical_calibration {
+inline bool valid_coefficients(float a,float b) {
+    return std::isfinite(a) && std::isfinite(b) && a>0.f && a<1e8f && b<=0.f && b>=-1.f;
+}
+inline bool valid_area_coverage(float far_area,float near_area) {
+    return std::isfinite(far_area) && std::isfinite(near_area) && far_area>1.f && near_area>=far_area*1.2f;
+}
+inline bool valid_curve(float a,float b,float far_area,float near_area) {
+    if(!valid_coefficients(a,b) || !valid_area_coverage(far_area,near_area)) return false;
+    const double far_value=double(a)*std::exp(double(b)*far_area);
+    const double near_value=double(a)*std::exp(double(b)*near_area);
+    return std::isfinite(far_value) && std::isfinite(near_value) && far_value>1e-30 && near_value>1e-30;
+}
+}
